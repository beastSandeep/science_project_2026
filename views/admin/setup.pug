doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Initial Admin Setup – Science Fair 2026
    link(rel="icon" type="image/svg+xml" href="/favicon.svg")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet")
    script(src="https://cdn.tailwindcss.com")
    script.
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
              mono: ['JetBrains Mono', 'monospace'],
            }
          }
        }
      }
    style.
      .glass-panel {
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(51, 65, 85, 0.6);
      }
      .sci-grid {
        background-size: 38px 38px;
        background-image: 
          linear-gradient(to right, rgba(51, 65, 85, 0.08) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(51, 65, 85, 0.08) 1px, transparent 1px);
      }

  body(class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4 relative font-sans sci-grid")

    //- Ambient Luminous Orbs
    div(class="fixed top-[-15%] left-[-10%] w-[50vw] h-[50vw] bg-cyan-500/10 rounded-full blur-[140px] pointer-events-none")
    div(class="fixed bottom-[-15%] right-[-10%] w-[50vw] h-[50vw] bg-violet-600/10 rounded-full blur-[150px] pointer-events-none")

    div(class="relative z-10 w-full max-w-md")
      //- Card Container
      div(class="glass-panel rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6 border border-slate-800")
        
        //- Brand Header
        div(class="text-center space-y-2")
          div(class="w-12 h-12 mx-auto rounded-2xl bg-gradient-to-tr from-cyan-500 via-teal-400 to-violet-500 p-[1.5px] flex items-center justify-center shadow-lg shadow-cyan-500/25")
            div(class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center")
              svg(class="w-6 h-6 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                rect(width="18" height="11" x="3" y="11" rx="2" ry="2")
                path(d="M7 11V7a5 5 0 0 1 10 0v4")
          
          div(class="inline-flex items-center space-x-1.5 px-3 py-0.5 rounded-full bg-cyan-500/15 border border-cyan-500/30 text-cyan-300 text-[10px] font-mono font-bold")
            span 🚀
            span First-Time Deployment Setup

          h1(class="text-xl sm:text-2xl font-bold tracking-tight text-white") Set Master Admin Password
          p(class="text-xs text-slate-300 leading-relaxed")
            | Welcome to the Science Fair Lab! Create your master administrator credentials on this initial deployment. You can change this password at any time later.

        //- Error Alert
        if error
          div(class="p-3.5 rounded-xl bg-rose-950/40 border border-rose-500/40 text-xs text-rose-300 flex items-center space-x-2")
            svg(class="w-4 h-4 flex-shrink-0 text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
              circle(cx="12" cy="12" r="10")
              line(x1="12" y1="8" x2="12" y2="12")
              line(x1="12" y1="16" x2="12.01" y2="16")
            span= error

        //- Setup Form
        form(action="/admin/setup" method="POST" class="space-y-4")
          div(class="space-y-1.5")
            label(class="block text-xs font-mono uppercase tracking-wider text-slate-300 font-medium")
              | Admin Username <span class="text-rose-400">*</span>
            div(class="relative")
              div(class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500")
                svg(class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                  path(d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2")
                  circle(cx="12" cy="7" r="4")
              input(
                type="text"
                name="username"
                value="admin"
                required
                autocomplete="username"
                placeholder="Choose username (default: admin)"
                class="w-full pl-10 pr-3.5 py-2.5 bg-slate-900/90 border border-slate-700 rounded-xl text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition"
              )

          div(class="space-y-1.5")
            label(class="block text-xs font-mono uppercase tracking-wider text-slate-300 font-medium")
              | Choose New Password <span class="text-rose-400">*</span>
            div(class="relative")
              div(class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500")
                svg(class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                  rect(width="18" height="11" x="3" y="11" rx="2" ry="2")
                  path(d="M7 11V7a5 5 0 0 1 10 0v4")
              input(
                type="password"
                name="password"
                required
                minlength="6"
                autocomplete="new-password"
                placeholder="Enter password (minimum 6 characters)"
                class="w-full pl-10 pr-3.5 py-2.5 bg-slate-900/90 border border-slate-700 rounded-xl text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition"
              )

          div(class="space-y-1.5")
            label(class="block text-xs font-mono uppercase tracking-wider text-slate-300 font-medium")
              | Confirm Password <span class="text-rose-400">*</span>
            div(class="relative")
              div(class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500")
                svg(class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                  polyline(points="20 6 9 17 4 12")
              input(
                type="password"
                name="confirmPassword"
                required
                minlength="6"
                autocomplete="new-password"
                placeholder="Confirm your password"
                class="w-full pl-10 pr-3.5 py-2.5 bg-slate-900/90 border border-slate-700 rounded-xl text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition"
              )

          div(class="p-3 rounded-xl bg-slate-900/70 border border-slate-800 text-[11px] text-slate-400 space-y-1 font-mono")
            div(class="text-cyan-400 font-semibold flex items-center space-x-1.5")
              svg(class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                path(d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10")
              span Zero Default Credentials
            p Your password will be salted and hashed securely with scrypt before being saved. You can update it anytime in the Admin Dashboard.

          button(
            type="submit"
            class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-cyan-500 to-teal-400 hover:from-cyan-400 hover:to-teal-300 text-slate-950 font-bold text-sm tracking-wide shadow-lg shadow-cyan-500/20 transition-all flex items-center justify-center space-x-2"
          )
            span Complete Setup &amp; Launch Console
            svg(class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5")
              path(d="M5 12h14")
              path(d="m12 5 7 7-7 7")

        //- Footer links
        div(class="pt-4 border-t border-slate-800/80 text-center text-xs text-slate-400 flex items-center justify-between")
          a(href="/" class="hover:text-cyan-400 transition flex items-center space-x-1")
            svg(class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
              path(d="m15 18-6-6 6-6")
            span Back to Public Site
          span(class="font-mono text-slate-500") Owner: Sandeep Singh
