doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Science Fair Lab – Admin Console
    link(rel="icon" type="image/svg+xml" href="/favicon.svg")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet")
    script(src="https://cdn.tailwindcss.com")
    script.
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
              mono: ['JetBrains Mono', 'monospace'],
            }
          }
        }
      }
    script(defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js")
    style.
      [x-cloak] { display: none !important; }
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: #020617; }
      ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }
      ::-webkit-scrollbar-thumb:hover { background: #334155; }
      .glass-panel {
        background: rgba(15, 23, 42, 0.78);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(51, 65, 85, 0.55);
      }
      .glass-card {
        background: rgba(15, 23, 42, 0.68);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(51, 65, 85, 0.45);
        transition: all 0.25s ease;
      }
      .glass-card:hover {
        border-color: rgba(6, 182, 212, 0.45);
      }
      .sci-grid {
        background-size: 38px 38px;
        background-image: 
          linear-gradient(to right, rgba(51, 65, 85, 0.08) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(51, 65, 85, 0.08) 1px, transparent 1px);
      }

  body(class="bg-slate-950 text-slate-100 min-h-screen relative font-sans sci-grid" x-data="adminDashboardApp()" x-cloak)

    //- Ambient Luminous Orbs
    div(class="fixed top-[-10%] left-[-5%] w-[45vw] h-[45vw] bg-cyan-500/10 rounded-full blur-[140px] pointer-events-none")
    div(class="fixed bottom-[-10%] right-[-5%] w-[45vw] h-[45vw] bg-violet-600/10 rounded-full blur-[150px] pointer-events-none")

    //- Main Layout Wrapper
    div(class="relative z-10 flex flex-col min-h-screen")

      //- Sticky Admin Header
      header(class="sticky top-0 z-40 glass-panel border-b border-slate-800")
        div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between")
          //- Brand & Logo
          div(class="flex items-center space-x-3")
            div(class="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-500 via-teal-400 to-violet-500 p-[1.5px] flex items-center justify-center shadow-lg shadow-cyan-500/20")
              div(class="w-full h-full bg-slate-950 rounded-[11px] flex items-center justify-center")
                svg(class="w-5 h-5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                  path(d="M12 2v4")
                  path(d="m4.93 4.93 2.83 2.83")
                  path(d="M2 12h4")
                  path(d="m4.93 19.07 2.83-2.83")
                  path(d="M12 18v4")
                  path(d="m16.24 16.24 2.83 2.83")
                  path(d="M18 12h4")
                  path(d="m16.24 7.76 2.83-2.83")
            div
              div(class="flex items-center space-x-2")
                span(class="font-extrabold tracking-tight text-white text-sm sm:text-base") ADMIN PORTAL
                span(class="text-[10px] font-mono uppercase px-2 py-0.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 font-semibold") Team &amp; Winner Management
              p(class="text-[11px] text-slate-400 font-mono") Science Fair 2026 &bull; Owner: Sandeep Singh

          //- Top Controls
          div(class="flex items-center space-x-2 sm:space-x-3")
            button(
              @click="openAddModal()"
              class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-cyan-500 to-teal-400 hover:from-cyan-400 hover:to-teal-300 text-slate-950 font-bold text-xs shadow-lg shadow-cyan-500/20 transition flex items-center space-x-1.5"
            )
              svg(class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5")
                line(x1="12" y1="5" x2="12" y2="19")
                line(x1="5" y1="12" x2="19" y2="12")
              span Add Project

            a(
              href="/admin/api/export-csv"
              class="px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-700 hover:border-slate-600 text-xs text-slate-200 hover:text-white transition flex items-center space-x-1.5"
              title="Download full project & team assignment roster"
            )
              svg(class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                path(d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4")
                polyline(points="7 10 12 15 17 10")
                line(x1="12" y1="15" x2="12" y2="3")
              span(class="hidden sm:inline") Export CSV

            a(
              href="/"
              target="_blank"
              class="px-3 py-1.5 rounded-xl bg-cyan-500/10 border border-cyan-500/30 hover:bg-cyan-500/20 text-xs text-cyan-400 transition flex items-center space-x-1.5"
            )
              svg(class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                path(d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6")
                polyline(points="15 3 21 3 21 9")
                line(x1="10" y1="14" x2="21" y2="3")
              span(class="hidden sm:inline") Public Site

            a(
              href="/admin/logout"
              class="px-3 py-1.5 rounded-xl bg-rose-500/10 border border-rose-500/30 hover:bg-rose-500/20 text-xs text-rose-300 transition flex items-center space-x-1"
            )
              svg(class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                path(d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4")
                polyline(points="16 17 21 12 16 7")
                line(x1="21" y1="12" x2="9" y2="12")
              span Logout

      //- Main Content Container
      main(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full flex-1 space-y-8")

        //- Toast Notification
        div(
          x-show="toastMessage"
          x-transition
          class="fixed bottom-6 right-6 z-50 p-4 rounded-xl bg-slate-900 border border-cyan-500/60 shadow-2xl flex items-center space-x-3 text-xs text-cyan-300 font-mono"
        )
          svg(class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5")
            polyline(points="20 6 9 17 4 12")
          span(x-text="toastMessage")

        //- Stats Metric Cards
        div(class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5")
          //- Total
          div(class="glass-panel rounded-2xl p-4 border border-slate-800 space-y-1")
            div(class="text-[10px] font-mono uppercase tracking-wider text-slate-400") Total Models
            div(class="text-2xl font-extrabold text-white font-mono" x-text="stats.total")
            div(class="text-[10px] text-slate-500 font-mono") All Exhibits

          //- Assigned
          div(class="glass-panel rounded-2xl p-4 border border-cyan-500/30 space-y-1 bg-cyan-950/10")
            div(class="text-[10px] font-mono uppercase tracking-wider text-cyan-400") Assigned Teams
            div(class="text-2xl font-extrabold text-cyan-300 font-mono" x-text="stats.assigned")
            div(class="text-[10px] text-cyan-400/80 font-mono" x-text="stats.total > 0 ? Math.round((stats.assigned / stats.total) * 100) + '% assigned' : '0%'")

          //- In Progress
          div(class="glass-panel rounded-2xl p-4 border border-blue-500/30 space-y-1 bg-blue-950/10")
            div(class="text-[10px] font-mono uppercase tracking-wider text-blue-400") In Progress
            div(class="text-2xl font-extrabold text-blue-300 font-mono" x-text="stats.inProgress")
            div(class="text-[10px] text-blue-400/80 font-mono") Under Assembly

          //- Completed
          div(class="glass-panel rounded-2xl p-4 border border-emerald-500/30 space-y-1 bg-emerald-950/10")
            div(class="text-[10px] font-mono uppercase tracking-wider text-emerald-400") Completed
            div(class="text-2xl font-extrabold text-emerald-300 font-mono" x-text="stats.completed")
            div(class="text-[10px] text-emerald-400/80 font-mono") Ready for Fair

          //- Available
          div(class="glass-panel rounded-2xl p-4 border border-amber-500/30 space-y-1 bg-amber-950/10")
            div(class="text-[10px] font-mono uppercase tracking-wider text-amber-400") Available
            div(class="text-2xl font-extrabold text-amber-300 font-mono" x-text="stats.available")
            div(class="text-[10px] text-amber-400/80 font-mono") Needs Team

          //- Winners
          div(class="glass-panel rounded-2xl p-4 border border-yellow-500/40 space-y-1 bg-yellow-950/15 shadow-[0_0_20px_rgba(234,179,8,0.1)]")
            div(class="text-[10px] font-mono uppercase tracking-wider text-yellow-400 flex items-center space-x-1")
              span 🏆
              span Winners
            div(class="text-2xl font-extrabold text-yellow-300 font-mono" x-text="stats.winners || 0")
            div(class="text-[10px] text-yellow-400/80 font-mono") Award Declared

        //- Filter & Management Controls
        div(class="glass-panel rounded-2xl p-4 sm:p-5 border border-slate-800 space-y-4")
          div(class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center")
            //- Search input
            div(class="relative flex-1")
              div(class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400")
                svg(class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                  circle(cx="11" cy="11" r="8")
                  path(d="m21 21-4.3-4.3")
              input(
                type="text"
                x-model="searchQuery"
                placeholder="Search by title, student team names, roll, table, or award..."
                class="w-full pl-10 pr-9 py-2.5 bg-slate-900/90 border border-slate-700/80 rounded-xl text-sm text-slate-100 placeholder-slate-400 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition"
              )
              button(
                x-show="searchQuery"
                @click="searchQuery = ''"
                class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-white"
              )
                svg(class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                  path(d="M18 6 6 18")
                  path(d="m6 6 12 12")

            //- Status Filter Tabs
            div(class="flex items-center gap-1.5 p-1 bg-slate-900 border border-slate-800 rounded-xl overflow-x-auto")
              template(x-for="st in statusOptions" :key="st")
                button(
                  @click="selectedStatus = st"
                  :class="selectedStatus === st ? 'bg-cyan-500 text-slate-950 font-bold shadow-sm' : 'text-slate-400 hover:text-white'"
                  class="px-3 py-1.5 rounded-lg text-xs transition whitespace-nowrap"
                  x-text="st === 'All' ? 'All Statuses' : st"
                )
              button(
                @click="selectedStatus = 'WinnersOnly'"
                :class="selectedStatus === 'WinnersOnly' ? 'bg-yellow-400 text-slate-950 font-bold shadow-sm' : 'text-yellow-400 hover:text-white'"
                class="px-3 py-1.5 rounded-lg text-xs transition whitespace-nowrap flex items-center space-x-1"
              )
                span 🏆
                span Winners

          //- Category Filter Row
          div(class="flex items-center justify-between flex-wrap gap-2 pt-2 border-t border-slate-800/80")
            div(class="flex items-center flex-wrap gap-1.5")
              span(class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mr-1") Discipline:
              template(x-for="cat in categories" :key="cat")
                button(
                  @click="selectedCategory = cat"
                  :class="selectedCategory === cat ? 'bg-violet-600 text-white font-medium' : 'bg-slate-900/60 text-slate-400 hover:text-slate-200 border border-slate-800'"
                  class="px-2.5 py-1 rounded-lg text-xs transition"
                  x-text="cat"
                )
            div(class="text-xs font-mono text-slate-400")
              | Displaying 
              span(class="text-cyan-400 font-semibold" x-text="filteredModels().length")
              |  of <span x-text="models.length"></span> projects

        //- Projects Table / List
        div(class="glass-panel rounded-2xl border border-slate-800 overflow-hidden shadow-xl")
          div(class="overflow-x-auto")
            table(class="w-full text-left text-xs border-collapse")
              thead(class="bg-slate-950/80 border-b border-slate-800 text-[11px] font-mono uppercase tracking-wider text-slate-400")
                tr
                  th(class="py-3 px-4") Model
                  th(class="py-3 px-4") Discipline
                  th(class="py-3 px-4") Status
                  th(class="py-3 px-4") Award / Winner
                  th(class="py-3 px-4") Student Team
                  th(class="py-3 px-4") Table #
                  th(class="py-3 px-4 text-right") Action
              tbody(class="divide-y divide-slate-800/80 font-sans")
                template(x-for="model in filteredModels()" :key="model.id")
                  tr(class="hover:bg-slate-900/40 transition group" :class="model.isWinner ? 'bg-yellow-950/10' : ''")
                    //- Model info + Image
                    td(class="py-3 px-4")
                      div(class="flex items-center space-x-3")
                        div(class="w-12 h-12 rounded-lg bg-slate-950 overflow-hidden flex-shrink-0 border border-slate-800 relative")
                          img(:src="model.image" :alt="model.title" class="w-full h-full object-cover" onerror="this.src='/images/default-project.svg'")
                          template(x-if="model.isWinner")
                            div(class="absolute top-0 right-0 bg-yellow-500 text-slate-950 text-[10px] font-bold px-1 rounded-bl") 🏆
                        div
                          div(class="flex items-center space-x-1.5")
                            span(class="font-mono text-cyan-400 font-bold") #<span x-text="model.id < 10 ? '0' + model.id : model.id"></span>
                            span(class="font-bold text-white text-sm group-hover:text-cyan-300 transition" x-text="model.title")
                            template(x-if="model.isCustom")
                              span(class="px-1.5 py-0.5 rounded text-[9px] font-mono bg-violet-500/20 text-violet-300 border border-violet-500/30 font-semibold") Custom
                          p(class="text-[11px] text-slate-400 line-clamp-1 max-w-xs" x-text="model.concept")

                    //- Category
                    td(class="py-3 px-4")
                      span(class="px-2 py-0.5 rounded-md bg-slate-900 border border-slate-800 text-slate-300 font-mono text-[11px]" x-text="model.category")

                    //- Status Badge
                    td(class="py-3 px-4")
                      span(
                        class="px-2.5 py-1 rounded-full text-[11px] font-mono font-semibold border inline-flex items-center space-x-1"
                        :class="getStatusBadgeClass(model.status)"
                      )
                        span(class="w-1.5 h-1.5 rounded-full" :class="getStatusDotClass(model.status)")
                        span(x-text="model.status")

                    //- Award Badge
                    td(class="py-3 px-4")
                      template(x-if="model.award && model.award !== 'None'")
                        span(
                          class="px-2.5 py-1 rounded-full text-[11px] font-mono font-bold border inline-flex items-center space-x-1"
                          :class="getAwardBadgeClass(model.award)"
                        )
                          span(x-text="getAwardEmoji(model.award)")
                          span(x-text="model.award")
                      template(x-if="!model.award || model.award === 'None'")
                        span(class="text-slate-500 font-mono text-[11px]") &mdash;

                    //- Multi-Student Team
                    td(class="py-3 px-4")
                      template(x-if="model.assignedStudents && model.assignedStudents.length > 0")
                        div(class="space-y-1")
                          div(class="flex flex-wrap gap-1 items-center")
                            template(x-for="(stu, sIdx) in model.assignedStudents" :key="sIdx")
                              span(class="px-2 py-0.5 rounded bg-slate-900 border border-slate-700 text-white font-medium text-xs")
                                span(x-text="stu")
                          div(class="text-[10px] text-slate-400 font-mono" x-text="model.studentRoll || 'Team of ' + model.assignedStudents.length")
                      template(x-if="!model.assignedStudents || model.assignedStudents.length === 0")
                        button(
                          @click="openEditModal(model)"
                          class="px-2.5 py-1 rounded-lg border border-dashed border-slate-700 text-slate-400 hover:text-cyan-400 hover:border-cyan-500/50 transition font-mono text-[11px]"
                        ) + Assign Team

                    //- Booth Number
                    td(class="py-3 px-4 font-mono text-slate-300")
                      span(x-text="model.boothNumber || 'Unassigned'")

                    //- Action Buttons
                    td(class="py-3 px-4 text-right")
                      div(class="flex items-center justify-end space-x-1.5")
                        button(
                          @click="openEditModal(model)"
                          class="px-2.5 py-1.5 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 text-xs font-medium transition inline-flex items-center space-x-1"
                          title="Edit Team, Image &amp; Award"
                        )
                          svg(class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                            path(d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z")
                          span Edit

                        template(x-if="model.isCustom")
                          button(
                            @click="deleteCustomProject(model.id, model.title)"
                            class="p-1.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 text-xs transition"
                            title="Delete Custom Project"
                          )
                            svg(class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                              path(d="M3 6h18")
                              path(d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6")
                              path(d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2")

        //- Edit Assignment, Photo & Award Modal
        div(
          x-show="editingModel !== null"
          x-transition
          class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-5 bg-slate-950/85 backdrop-blur-md overflow-y-auto"
          @keydown.escape.window="closeEditModal()"
        )
          div(
            x-show="editingModel !== null"
            @click.outside="closeEditModal()"
            class="relative w-full max-w-2xl bg-slate-900 border border-slate-800 rounded-2xl shadow-2xl overflow-hidden my-auto max-h-[92vh] flex flex-col"
          )
            //- Modal Header
            div(class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between bg-slate-950/70")
              div
                div(class="flex items-center space-x-2")
                  span(class="font-mono text-xs px-2 py-0.5 rounded bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 font-bold")
                    | Model #
                    span(x-text="editingModel?.id")
                  span(class="text-xs font-mono text-slate-400" x-text="editingModel?.category")
                h2(class="text-lg font-bold text-white mt-1" x-text="editingModel?.title")
              
              button(
                @click="closeEditModal()"
                class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition"
              )
                svg(class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                  path(d="M18 6 6 18")
                  path(d="m6 6 12 12")

            //- Modal Body / Form
            div(class="p-4 sm:p-6 overflow-y-auto space-y-5 text-xs")

              //- Photo Upload Section
              div(class="p-4 rounded-xl bg-slate-950/60 border border-slate-800 space-y-3")
                div(class="flex items-center justify-between")
                  div(class="flex items-center space-x-2 text-cyan-400 font-mono font-bold uppercase")
                    svg(class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                      path(d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11")
                      circle(cx="9" cy="9" r="2")
                      path(d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21")
                    span Project Photo (Upload When Built / Ready)
                  span(class="text-[10px] text-slate-400") Max 15MB (JPG, PNG, WEBP)

                div(class="flex flex-col sm:flex-row items-center gap-4")
                  div(class="w-28 h-20 rounded-lg bg-slate-900 border border-slate-700 overflow-hidden flex-shrink-0")
                    img(:src="editForm.image || editingModel?.image" class="w-full h-full object-cover" onerror="this.src='/images/default-project.svg'")
                  
                  div(class="flex-1 w-full space-y-1.5")
                    label(class="block")
                      input(
                        type="file"
                        accept="image/*"
                        @change="uploadPhoto($event)"
                        class="block w-full text-xs text-slate-400 file:mr-3 file:py-1.5 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-cyan-500/10 file:text-cyan-400 hover:file:bg-cyan-500/20 cursor-pointer"
                      )
                    p(class="text-[11px] text-slate-500") Upload real photo of the completed working model taken on phone or camera.

              form(@submit.prevent="saveProjectChanges()" class="space-y-4")
                
                //- Multi-Student Team Members
                div(class="space-y-1.5")
                  div(class="flex items-center justify-between")
                    label(class="block font-mono uppercase tracking-wider text-slate-300 font-semibold")
                      | Assigned Student(s) / Team Members
                    span(class="text-[10px] text-slate-400") Separate multiple students with commas or new lines
                  textarea(
                    rows="2"
                    x-model="editForm.assignedStudentsText"
                    placeholder="e.g. Rahul Sharma, Priya Verma, Amit Kumar"
                    class="w-full px-3 py-2 bg-slate-950/90 border border-slate-700 rounded-xl text-sm text-white focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 font-sans"
                  )

                //- Student Roll & Booth
                div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
                  div(class="space-y-1.5")
                    label(class="block font-mono uppercase tracking-wider text-slate-300 font-semibold")
                      | Roll Numbers / Contact Info
                    input(
                      type="text"
                      x-model="editForm.studentRoll"
                      placeholder="e.g. Roll 12, 14, 15 / Sec B"
