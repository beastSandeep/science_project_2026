    //- Embedded Alpine Store
    script.
      const initialModels = !{JSON.stringify(models)};
      const initialStats = !{JSON.stringify(stats)};

      function adminDashboardApp() {
        return {
          models: initialModels,
          stats: initialStats,
          searchQuery: '',
          selectedStatus: 'All',
          selectedCategory: 'All',
          editingModel: null,
          isAddingProject: false,
          isSaving: false,
          toastMessage: '',
          categories: ['All', 'Physics', 'Mechanics', 'Electricity', 'Optics', 'Biology', 'Chemistry', 'Earth & Space'],
          statusOptions: ['All', 'Available', 'In Progress', 'Completed', 'Exhibited'],

          editForm: {
            assignedStudentsText: '',
            studentRoll: '',
            status: 'Available',
            award: 'None',
            boothNumber: '',
            submissionDate: '',
            notes: '',
            image: ''
          },

          addForm: {
            title: '',
            category: 'Physics',
            concept: '',
            difficulty: 'Beginner',
            buildTime: '2 hours',
            realWorldApp: '',
            howItWorks: '',
            materials: '',
            speech: '',
            image: '',
            assignedStudents: '',
            studentRoll: '',
            status: 'Available',
            boothNumber: ''
          },

          filteredModels() {
            return this.models.filter(m => {
              // Status filter including winners only
              let statusMatch = true;
              if (this.selectedStatus === 'WinnersOnly') {
                statusMatch = m.award && m.award !== 'None';
              } else if (this.selectedStatus !== 'All') {
                statusMatch = m.status === this.selectedStatus;
              }

              const catMatch = this.selectedCategory === 'All' || m.category === this.selectedCategory;
              const q = this.searchQuery.toLowerCase().trim();
              const studentsMatch = m.assignedStudents && m.assignedStudents.some(s => s.toLowerCase().includes(q));
              const queryMatch = !q ||
                m.title.toLowerCase().includes(q) ||
                m.id.toString() === q ||
                studentsMatch ||
                (m.assignedStudent && m.assignedStudent.toLowerCase().includes(q)) ||
                (m.boothNumber && m.boothNumber.toLowerCase().includes(q)) ||
                (m.studentRoll && m.studentRoll.toLowerCase().includes(q)) ||
                (m.award && m.award.toLowerCase().includes(q));

              return statusMatch && catMatch && queryMatch;
            });
          },

          getStatusBadgeClass(status) {
            if (status === 'Completed') return 'bg-emerald-950/60 border-emerald-500/40 text-emerald-300';
            if (status === 'In Progress') return 'bg-blue-950/60 border-blue-500/40 text-blue-300';
            if (status === 'Exhibited') return 'bg-violet-950/60 border-violet-500/40 text-violet-300';
            return 'bg-amber-950/60 border-amber-500/40 text-amber-300';
          },

          getStatusDotClass(status) {
            if (status === 'Completed') return 'bg-emerald-400';
            if (status === 'In Progress') return 'bg-blue-400';
            if (status === 'Exhibited') return 'bg-violet-400';
            return 'bg-amber-400';
          },

          getAwardBadgeClass(award) {
            if (award.includes('1st')) return 'bg-yellow-950/70 border-yellow-500/60 text-yellow-300 shadow-[0_0_12px_rgba(234,179,8,0.2)]';
            if (award.includes('2nd')) return 'bg-slate-900 border-slate-400 text-slate-200';
            if (award.includes('3rd')) return 'bg-amber-950/70 border-amber-600 text-amber-300';
            return 'bg-cyan-950/70 border-cyan-500/60 text-cyan-300';
          },

          getAwardEmoji(award) {
            if (award.includes('1st')) return '🥇 ';
            if (award.includes('2nd')) return '🥈 ';
            if (award.includes('3rd')) return '🥉 ';
            if (award.includes('Innovation')) return '🌟 ';
            return '⚙️ ';
          },

          openEditModal(model) {
            this.editingModel = model;
            const studentsList = model.assignedStudents && model.assignedStudents.length > 0 
              ? model.assignedStudents.join(', ') 
              : (model.assignedStudent || '');

            this.editForm = {
              assignedStudentsText: studentsList,
              studentRoll: model.studentRoll || '',
              status: model.status || 'Available',
              award: model.award || 'None',
              boothNumber: model.boothNumber || '',
              submissionDate: model.submissionDate || '',
              notes: model.notes || '',
              image: model.image || ''
            };
          },

          closeEditModal() {
            this.editingModel = null;
          },

          async uploadPhoto(event) {
            const file = event.target.files[0];
            if (!file || !this.editingModel) return;

            const formData = new FormData();
            formData.append('photo', file);

            try {
              this.showToast('Uploading project photo...');
              const res = await fetch(`/admin/api/projects/${this.editingModel.id}/upload-image`, {
                method: 'POST',
                body: formData
              });

              if (!res.ok) throw new Error('Upload failed');
              const data = await res.json();

              this.editForm.image = data.imageUrl;
              const idx = this.models.findIndex(m => m.id === data.project.id);
              if (idx !== -1) {
                this.models[idx] = data.project;
              }
              this.stats = data.stats;
              this.showToast('Project photo uploaded and saved successfully!');
            } catch (err) {
              alert('Error uploading photo: ' + err.message);
            }
          },

          async saveProjectChanges() {
            if (!this.editingModel) return;
            this.isSaving = true;

            const payload = {
              assignedStudents: this.editForm.assignedStudentsText,
              studentRoll: this.editForm.studentRoll,
              status: this.editForm.status,
              award: this.editForm.award,
              boothNumber: this.editForm.boothNumber,
              submissionDate: this.editForm.submissionDate,
              notes: this.editForm.notes,
              image: this.editForm.image
            };

            try {
              const res = await fetch(`/admin/api/projects/${this.editingModel.id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });

              if (!res.ok) throw new Error('Save failed');
              const data = await res.json();

              const idx = this.models.findIndex(m => m.id === data.project.id);
              if (idx !== -1) {
                this.models[idx] = data.project;
              }
              this.stats = data.stats;

              this.showToast(`Updated Model #${data.project.id} (${data.project.title})`);
              this.closeEditModal();
            } catch (err) {
              alert('Error saving project changes: ' + err.message);
            } finally {
              this.isSaving = false;
            }
          },

          openAddModal() {
            this.addForm = {
              title: '',
              category: 'Physics',
              concept: '',
              difficulty: 'Beginner',
              buildTime: '2 hours',
              realWorldApp: '',
              howItWorks: '',
              materials: '',
              speech: '',
              image: '',
              assignedStudents: '',
              studentRoll: '',
              status: 'Available',
              boothNumber: `Table ${this.models.length + 1}`
            };
            this.isAddingProject = true;
          },

          closeAddModal() {
            this.isAddingProject = false;
          },

          async submitAddProject() {
            this.isSaving = true;
            try {
              const res = await fetch('/admin/api/projects/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(this.addForm)
              });

              if (!res.ok) throw new Error('Failed to create project');
              const data = await res.json();

              this.models.push(data.project);
              this.stats = data.stats;

              this.showToast(`Created Model #${data.project.id}: "${data.project.title}"`);
              this.closeAddModal();
            } catch (err) {
              alert('Error creating project: ' + err.message);
            } finally {
              this.isSaving = false;
            }
          },

          async deleteCustomProject(id, title) {
            if (!confirm(`Are you sure you want to delete custom model #${id} ("${title}")?`)) {
              return;
            }

            try {
              const res = await fetch(`/admin/api/projects/${id}`, {
                method: 'DELETE'
              });

              if (!res.ok) throw new Error('Delete failed');
              const data = await res.json();

              this.models = this.models.filter(m => m.id !== id);
              this.stats = data.stats;
              this.showToast(`Deleted Model #${id}`);
            } catch (err) {
              alert('Error deleting project: ' + err.message);
            }
          },

          showToast(msg) {
            this.toastMessage = msg;
            setTimeout(() => {
              if (this.toastMessage === msg) this.toastMessage = '';
            }, 3000);
          }
        };
      }
