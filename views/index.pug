    //- Embedded Server Data & Alpine Store
    script.
      const initialModels = !{JSON.stringify(models)};
      const initialIsVotingOpen = !{JSON.stringify(Boolean(isVotingOpen))};
      const initialExhibitionDate = !{JSON.stringify(exhibitionDate || '')};

      function scienceFairApp() {
        return {
          models: initialModels,
          isVotingOpen: initialIsVotingOpen,
          exhibitionDate: initialExhibitionDate,
          mobileMenuOpen: false,
          searchQuery: '',
          selectedDifficulty: 'All',
          selectedCategory: 'All',
          activeModel: null,
          copiedId: null,
          isSpeaking: false,
          categories: ['All', '🏆 Winners', 'Physics', 'Mechanics', 'Electricity', 'Optics', 'Biology', 'Chemistry', 'Earth & Space'],

          async init() {
            try {
              const res = await fetch('/api/models');
              if (res.ok) {
                const data = await res.json();
                if (data.models && Array.isArray(data.models)) {
                  this.models = data.models;
                }
                if (data.isVotingOpen !== undefined) {
                  this.isVotingOpen = Boolean(data.isVotingOpen);
                }
                if (data.exhibitionDate !== undefined) {
                  this.exhibitionDate = data.exhibitionDate || '';
                }
              }
            } catch (err) {
              console.warn('Initial models loaded from server memory cache');
            }

            this.$nextTick(() => {
              initScrollReveal();
            });

            this.$watch('searchQuery', () => {
              this.$nextTick(() => initScrollReveal());
            });
            this.$watch('selectedCategory', () => {
              this.$nextTick(() => initScrollReveal());
            });
            this.$watch('selectedDifficulty', () => {
              this.$nextTick(() => initScrollReveal());
            });
          },

          getCategoryCount(cat) {
            return this.models.filter(m => m.category === cat).length;
          },

          filteredModels() {
            return this.models.filter(m => {
              // Difficulty level filter
              const diffMatch = this.selectedDifficulty === 'All' || m.difficulty === this.selectedDifficulty;
              // Category filter with Winners support
              const categoryMatch = this.selectedCategory === 'All' ? true :
                this.selectedCategory === '🏆 Winners' ? (m.isWinner === true) :
                m.category === this.selectedCategory;
              // Query filter
              const q = this.searchQuery.toLowerCase().trim();
              const queryMatch = !q || 
                m.title.toLowerCase().includes(q) || 
                m.concept.toLowerCase().includes(q) || 
                m.rawMaterials.toLowerCase().includes(q) ||
                m.speech.toLowerCase().includes(q) ||
                (m.howItWorks && m.howItWorks.toLowerCase().includes(q)) ||
                (m.realWorldApp && m.realWorldApp.toLowerCase().includes(q)) ||
                (m.award && m.award.toLowerCase().includes(q)) ||
                (m.assignedStudents && m.assignedStudents.some(s => s.toLowerCase().includes(q))) ||
                (m.assignedStudent && m.assignedStudent.toLowerCase().includes(q));

              return diffMatch && categoryMatch && queryMatch;
            });
          },

          getAwardEmoji(award) {
            if (!award) return '🏅';
            if (award.includes('1st')) return '🥇';
            if (award.includes('2nd')) return '🥈';
            if (award.includes('3rd')) return '🥉';
            if (award.includes('Innovation')) return '💡';
            if (award.includes('Mechanism')) return '⚙️';
            return '🏆';
          },

          getAwardBadgeClass(award) {
            if (!award) return 'bg-slate-800 border-slate-700 text-slate-300';
            if (award.includes('1st')) return 'bg-amber-500/25 border-amber-500/70 text-amber-300 shadow-amber-500/20';
            if (award.includes('2nd')) return 'bg-slate-300/25 border-slate-300/70 text-slate-100 shadow-slate-300/20';
            if (award.includes('3rd')) return 'bg-amber-700/30 border-amber-600/70 text-amber-200';
            if (award.includes('Innovation')) return 'bg-cyan-500/25 border-cyan-500/70 text-cyan-300';
            if (award.includes('Mechanism')) return 'bg-violet-500/25 border-violet-500/70 text-violet-300';
            return 'bg-amber-500/25 border-amber-500/60 text-amber-300';
          },

          getAwardBannerClass(award) {
            if (!award) return 'bg-slate-900 border-slate-700';
            if (award.includes('1st')) return 'bg-gradient-to-r from-amber-950/70 via-amber-900/40 to-slate-900 border-amber-500/60';
            if (award.includes('2nd')) return 'bg-gradient-to-r from-slate-800/80 via-slate-700/40 to-slate-900 border-slate-400/60';
            if (award.includes('3rd')) return 'bg-gradient-to-r from-amber-950/80 via-amber-900/50 to-slate-900 border-amber-600/60';
            return 'bg-gradient-to-r from-violet-950/70 via-cyan-950/50 to-slate-900 border-cyan-500/60';
          },

          getDifficultyClass(level) {
            if (level === 'Beginner') return 'bg-emerald-950/80 border-emerald-700/60 text-emerald-300';
            if (level === 'Intermediate') return 'bg-cyan-950/80 border-cyan-700/60 text-cyan-300';
            if (level === 'Advanced') return 'bg-violet-950/80 border-violet-700/60 text-violet-300';
            return 'bg-slate-800 border-slate-700 text-slate-300';
          },

          openModal(model) {
            this.activeModel = model;
            if (this.isSpeaking) {
              window.speechSynthesis?.cancel();
              this.isSpeaking = false;
            }
          },

          openModelById(id) {
            const m = this.models.find(item => item.id === id);
            if (m) this.openModal(m);
          },

          closeModal() {
            this.activeModel = null;
            if (this.isSpeaking) {
              window.speechSynthesis?.cancel();
              this.isSpeaking = false;
            }
          },

          copySpeech(text, id) {
            if (!text) return;
            navigator.clipboard.writeText(text).then(() => {
              this.copiedId = id;
              setTimeout(() => {
                if (this.copiedId === id) this.copiedId = null;
              }, 2000);
            }).catch(err => {
              console.error('Clipboard copy failed:', err);
            });
          },

          toggleSpeech(text) {
            if (!('speechSynthesis' in window)) {
              alert('Speech Synthesis is not supported in this browser.');
              return;
            }

            if (this.isSpeaking) {
              window.speechSynthesis.cancel();
              this.isSpeaking = false;
              return;
            }

            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.rate = 0.95;
            utterance.pitch = 1.0;
            utterance.onend = () => {
              this.isSpeaking = false;
            };
            utterance.onerror = () => {
              this.isSpeaking = false;
            };

            this.isSpeaking = true;
            window.speechSynthesis.speak(utterance);
          },

          filterByCategory(cat) {
            this.selectedCategory = cat;
            this.scrollToSection('models-section');
          },

          scrollToSection(id) {
            const el = document.getElementById(id);
            if (el) {
              el.scrollIntoView({ behavior: 'smooth' });
            }
          },

          handleKeyboard(e) {
            if (e.key === '/' && document.activeElement.tagName !== 'INPUT') {
              e.preventDefault();
              const inp = document.getElementById('searchInput');
              if (inp) inp.focus();
            } else if (e.key === 'Escape' && this.activeModel) {
              this.closeModal();
            }
          }
        };
      }

      //- Scroll Entrance Animation Observer (Triggers strictly once)
      function initScrollReveal() {
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('.scroll-reveal').forEach(el => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              obs.unobserve(entry.target); // Guarantees animation triggers strictly once
            }
          });
        }, {
          root: null,
          rootMargin: '0px 0px -30px 0px',
          threshold: 0.05
        });

        document.querySelectorAll('.scroll-reveal:not(.is-revealed)').forEach(el => {
          observer.observe(el);
        });
      }

      document.addEventListener('DOMContentLoaded', () => {
        initScrollReveal();
      });

      //- Interactive Scientific Particle & Orbital Canvas Animation
      (function() {
        const canvas = document.getElementById('scientificCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');

        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
          initNodes();
        });

        const mouse = { x: null, y: null, radius: 140 };
        window.addEventListener('mousemove', (e) => {
          mouse.x = e.clientX;
          mouse.y = e.clientY;
        });
        window.addEventListener('mouseleave', () => {
          mouse.x = null;
          mouse.y = null;
        });
        window.addEventListener('touchmove', (e) => {
          if (e.touches && e.touches.length > 0) {
            mouse.x = e.touches[0].clientX;
            mouse.y = e.touches[0].clientY;
          }
        }, { passive: true });
        window.addEventListener('touchend', () => {
          mouse.x = null;
          mouse.y = null;
        });

        const nodeCount = Math.min(Math.floor((width * height) / 22000), 55);
        let nodes = [];

        function initNodes() {
          nodes = [];
          for (let i = 0; i < nodeCount; i++) {
            nodes.push({
              x: Math.random() * width,
              y: Math.random() * height,
              vx: (Math.random() - 0.5) * 0.45,
              vy: (Math.random() - 0.5) * 0.45,
              radius: Math.random() * 1.8 + 1,
              color: i % 3 === 0 ? 'rgba(34, 211, 238,' : (i % 3 === 1 ? 'rgba(167, 139, 250,' : 'rgba(52, 211, 153,')
            });
          }
        }
        initNodes();

        let orbitAngle = 0;

        function animate() {
          ctx.clearRect(0, 0, width, height);

          // 1. Draw connecting scientific bonds between nearby nodes
          for (let i = 0; i < nodes.length; i++) {
            for (let j = i + 1; j < nodes.length; j++) {
              const dx = nodes[i].x - nodes[j].x;
              const dy = nodes[i].y - nodes[j].y;
              const dist = Math.sqrt(dx * dx + dy * dy);

              if (dist < 130) {
                const alpha = (1 - dist / 130) * 0.22;
                ctx.beginPath();
                ctx.moveTo(nodes[i].x, nodes[i].y);
                ctx.lineTo(nodes[j].x, nodes[j].y);
                ctx.strokeStyle = `rgba(34, 211, 238, ${alpha})`;
                ctx.lineWidth = 0.8;
                ctx.stroke();
              }
            }
          }

          // 2. Draw nodes & handle velocities + mouse repulsion
          for (let i = 0; i < nodes.length; i++) {
            const n = nodes[i];

            if (mouse.x !== null && mouse.y !== null) {
              const mdx = n.x - mouse.x;
              const mdy = n.y - mouse.y;
              const mdist = Math.sqrt(mdx * mdx + mdy * mdy);
              if (mdist < mouse.radius) {
                const force = (mouse.radius - mdist) / mouse.radius;
                n.x += (mdx / mdist) * force * 1.5;
                n.y += (mdy / mdist) * force * 1.5;
              }
            }

            n.x += n.vx;
            n.y += n.vy;

            if (n.x < 0 || n.x > width) n.vx *= -1;
            if (n.y < 0 || n.y > height) n.vy *= -1;

            ctx.beginPath();
            ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
            ctx.fillStyle = n.color + '0.75)';
            ctx.shadowBlur = 8;
            ctx.shadowColor = n.color + '0.9)';
            ctx.fill();
            ctx.shadowBlur = 0;
          }

          // 3. Faint drifting Atomic Orbits with rotating electrons in background
          orbitAngle += 0.003;
          const centerX = width * 0.82;
          const centerY = height * 0.28;

          ctx.save();
          ctx.translate(centerX, centerY);

          const orbits = [
            { rx: 160, ry: 55, rot: 0.6 + orbitAngle * 0.2, speed: 1.2 },
            { rx: 190, ry: 65, rot: -0.7 + orbitAngle * 0.25, speed: 0.9 },
            { rx: 140, ry: 75, rot: 1.8 + orbitAngle * 0.15, speed: 1.5 }
          ];

          for (let o of orbits) {
            ctx.save();
            ctx.rotate(o.rot);

            ctx.beginPath();
            ctx.ellipse(0, 0, o.rx, o.ry, 0, 0, Math.PI * 2);
            ctx.strokeStyle = 'rgba(34, 211, 238, 0.07)';
            ctx.lineWidth = 1;
            ctx.stroke();

            const eAngle = orbitAngle * o.speed * 4;
            const ex = Math.cos(eAngle) * o.rx;
            const ey = Math.sin(eAngle) * o.ry;

            ctx.beginPath();
            ctx.arc(ex, ey, 2.5, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(34, 211, 238, 0.65)';
            ctx.shadowBlur = 10;
            ctx.shadowColor = '#22d3ee';
            ctx.fill();
            ctx.shadowBlur = 0;

            ctx.restore();
          }

          ctx.restore();

          requestAnimationFrame(animate);
        }

        animate();
      })();
