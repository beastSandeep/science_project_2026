doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Science Fair Lab – 20 Practical Working Models
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet")
    script(src="https://cdn.tailwindcss.com")
    script.
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
              mono: ['JetBrains Mono', 'monospace'],
            },
            colors: {
              scicyan: {
                400: '#22d3ee',
                500: '#06b6d4',
                600: '#0891b2',
              },
              sciviolet: {
                400: '#a78bfa',
                500: '#8b5cf6',
                600: '#7c3aed',
              }
            },
            animation: {
              'pulse-slow': 'pulse 7s cubic-bezier(0.4, 0, 0.6, 1) infinite',
              'spin-slow': 'spin 25s linear infinite',
            }
          }
        }
      }
    script(defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js")
    style.
      [x-cloak] { display: none !important; }
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: #020617; }
      ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }
      ::-webkit-scrollbar-thumb:hover { background: #334155; }
      .no-scrollbar::-webkit-scrollbar { display: none; }
      .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
      .glass-panel {
        background: rgba(15, 23, 42, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(51, 65, 85, 0.55);
      }
      .glass-card {
        background: rgba(15, 23, 42, 0.68);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(51, 65, 85, 0.45);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .glass-card:hover {
        border-color: rgba(6, 182, 212, 0.55);
        box-shadow: 0 0 32px -4px rgba(6, 182, 212, 0.2);
        transform: translateY(-4px);
      }
      .text-glow-cyan {
        text-shadow: 0 0 24px rgba(6, 182, 212, 0.45);
      }
      .sci-grid {
        background-size: 38px 38px;
        background-image: 
          linear-gradient(to right, rgba(51, 65, 85, 0.08) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(51, 65, 85, 0.08) 1px, transparent 1px);
      }

  body(class="bg-slate-950 text-slate-100 min-h-screen relative font-sans overflow-x-hidden selection:bg-cyan-500 selection:text-black sci-grid" x-data="scienceFairApp()" @keydown.window="handleKeyboard($event)" x-cloak)

    //- Dynamic Scientific Canvas Background
    canvas#scientificCanvas(class="fixed inset-0 pointer-events-none z-0 opacity-70")

    //- Ambient Luminous Orbs
    div(class="fixed top-[-10%] left-[-5%] w-[48vw] h-[48vw] bg-cyan-500/10 rounded-full blur-[130px] pointer-events-none animate-pulse-slow z-0")
    div(class="fixed bottom-[-10%] right-[-5%] w-[52vw] h-[52vw] bg-violet-600/10 rounded-full blur-[150px] pointer-events-none animate-pulse-slow z-0")

    //- Main Layout Wrapper
    div(class="relative z-10 flex flex-col min-h-screen")

      //- Minimalist Glass Navbar
      header(class="sticky top-0 z-40 glass-panel border-b border-slate-800/80")
        div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between")
          //- Brand & Logo
          div(class="flex items-center space-x-3 cursor-pointer" @click="scrollToSection('hero-section')")
            div(class="w-10 h-10 rounded-xl bg-gradient-to-tr from-cyan-500 via-teal-400 to-violet-500 p-[1.5px] flex items-center justify-center shadow-lg shadow-cyan-500/25")
              div(class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center")
                svg(class="w-5 h-5 text-cyan-400 animate-spin-slow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                  circle(cx="12" cy="12" r="3")
                  path(d="M12 2v2")
                  path(d="M12 20v2")
                  path(d="m4.93 4.93 1.41 1.41")
                  path(d="m17.66 17.66 1.41 1.41")
                  path(d="M2 12h2")
                  path(d="M20 12h2")
                  path(d="m6.34 17.66-1.41 1.41")
                  path(d="m19.07 4.93-1.41 1.41")
            div
              div(class="flex items-center space-x-2")
                span(class="font-extrabold tracking-tight text-white text-base") SCIENCE FAIR LAB
                span(class="text-[10px] font-mono uppercase px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-semibold") For Everyone
              p(class="text-[11px] text-slate-400 font-mono tracking-wide") 20 Working Models &bull; Open STEM Exhibition

          //- Quick Nav Links
          nav(class="flex items-center space-x-2 sm:space-x-3")
            a(
              href="https://github.com/beastSandeep"
              target="_blank"
              rel="noopener noreferrer"
              class="hidden sm:inline-flex items-center space-x-1 px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-xs text-slate-300 hover:text-white hover:border-cyan-500/40 transition"
            )
              span(class="text-slate-400") Owner:
              span(class="text-cyan-400 font-semibold") Sandeep Singh
            button(
              @click="scrollToSection('models-section')"
              class="px-3 py-1.5 rounded-lg text-xs font-medium text-cyan-400 bg-cyan-500/10 border border-cyan-500/30 hover:bg-cyan-500/20 transition-all flex items-center space-x-1.5"
            )
              span Models (20)
            button(
              @click="scrollToSection('blueprint-section')"
              class="hidden sm:inline-flex px-3 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800 border border-transparent hover:border-slate-700 transition-all"
            )
              span Presentation Formula
            button(
              @click="scrollToSection('rubric-section')"
              class="hidden sm:inline-flex px-3 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800 border border-transparent hover:border-slate-700 transition-all"
            )
              span Judging Rubric
            a(
              href="/admin"
              class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-cyan-400 bg-slate-900 border border-slate-800 hover:border-cyan-500/40 transition-all flex items-center space-x-1"
              title="Admin & Coordinator Console"
            )
              svg(class="w-3.5 h-3.5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                rect(width="18" height="11" x="3" y="11" rx="2" ry="2")
                path(d="M7 11V7a5 5 0 0 1 10 0v4")
              span Admin

      //- Hero Section
      section#hero-section(class="pt-10 pb-6 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full")
        div(class="text-center max-w-3xl mx-auto space-y-4")
          div(class="flex flex-wrap items-center justify-center gap-2")
            div(class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-slate-900/90 border border-slate-700/80 text-xs font-mono text-cyan-300 shadow-inner")
              span(class="w-2 h-2 rounded-full bg-cyan-400 animate-ping")
              span Complete Working Mechanisms &bull; Open to All Curious Minds
            a(
              href="https://github.com/beastSandeep"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full bg-slate-900/90 border border-slate-800 hover:border-cyan-500/40 text-xs font-mono text-slate-400 transition"
            )
              span Owned by
              span(class="text-cyan-400 font-semibold") Sandeep Singh
          h1(class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight")
            | 20 Practical 
            span(class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-violet-400 text-glow-cyan") Science Models
          p(class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto")
            | Explore authentic hands-on models with scientific working principles, required materials, real-world industry applications, and ready-to-recite presentation speeches.

        //- Filter & Search Control Panel
        div(class="mt-8 glass-panel rounded-2xl p-4 sm:p-5 shadow-2xl border border-slate-800/90 space-y-4")
          div(class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center")
            //- Search Input
            div(class="relative flex-1")
              div(class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400")
                svg(class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                  circle(cx="11" cy="11" r="8")
                  path(d="m21 21-4.3-4.3")
              input(
                id="searchInput"
                type="text"
                x-model="searchQuery"
                placeholder="Search models, concepts (e.g. Pascal, Induction, Optics, Motor) or materials..."
                class="w-full pl-10 pr-16 py-2.5 bg-slate-900/90 border border-slate-700/80 rounded-xl text-sm text-slate-100 placeholder-slate-400 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition"
              )
              div(class="absolute inset-y-0 right-0 pr-3 flex items-center space-x-1.5")
                button(
                  x-show="searchQuery"
                  @click="searchQuery = ''"
                  class="text-slate-400 hover:text-white"
                )
                  svg(class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                    path(d="M18 6 6 18")
                    path(d="m6 6 12 12")
                span(class="hidden md:inline-block text-[10px] font-mono text-slate-400 px-1.5 py-0.5 rounded bg-slate-800 border border-slate-700") /

            //- Difficulty Filters (Replacing grade classes, suitable for everyone)
            div(class="flex items-center gap-1.5 p-1 bg-slate-900/90 border border-slate-800 rounded-xl overflow-x-auto no-scrollbar")
              button(
                @click="selectedDifficulty = 'All'"
                :class="selectedDifficulty === 'All' ? 'bg-cyan-500 text-slate-950 font-semibold shadow-sm' : 'text-slate-400 hover:text-white'"
                class="px-3 py-1.5 rounded-lg text-xs transition whitespace-nowrap"
              ) All Levels
              button(
                @click="selectedDifficulty = 'Beginner'"
                :class="selectedDifficulty === 'Beginner' ? 'bg-emerald-500 text-slate-950 font-semibold shadow-sm' : 'text-slate-400 hover:text-white'"
                class="px-3 py-1.5 rounded-lg text-xs transition whitespace-nowrap"
              ) Beginner
              button(
                @click="selectedDifficulty = 'Intermediate'"
                :class="selectedDifficulty === 'Intermediate' ? 'bg-cyan-500 text-slate-950 font-semibold shadow-sm' : 'text-slate-400 hover:text-white'"
                class="px-3 py-1.5 rounded-lg text-xs transition whitespace-nowrap"
              ) Intermediate
              button(
                @click="selectedDifficulty = 'Advanced'"
                :class="selectedDifficulty === 'Advanced' ? 'bg-violet-500 text-slate-950 font-semibold shadow-sm' : 'text-slate-400 hover:text-white'"
                class="px-3 py-1.5 rounded-lg text-xs transition whitespace-nowrap"
              ) Advanced

          //- Category Pills
          div(class="flex items-center justify-between flex-wrap gap-2 pt-2 border-t border-slate-800/80")
            div(class="flex items-center flex-wrap gap-1.5")
              span(class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mr-1") Discipline:
              template(x-for="cat in categories" :key="cat")
                button(
                  @click="selectedCategory = cat"
                  :class="selectedCategory === cat ? 'bg-violet-600 text-white font-medium shadow-md shadow-violet-500/20' : 'bg-slate-900/60 text-slate-400 hover:text-slate-200 border border-slate-800'"
                  class="px-2.5 py-1 rounded-lg text-xs transition"
                  x-text="cat"
                )
            div(class="text-xs font-mono text-slate-400")
              | Showing 
              span(class="text-cyan-400 font-semibold" x-text="filteredModels().length")
              |  of 20 models

      //- Main Content: 20 Models Grid
      main#models-section(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 w-full flex-1")
        //- Empty State
        div(
          x-show="filteredModels().length === 0"
          class="glass-panel rounded-2xl p-12 text-center max-w-md mx-auto my-12 space-y-3"
        )
          div(class="w-12 h-12 mx-auto rounded-full bg-slate-800 flex items-center justify-center text-slate-400")
            svg(class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
              circle(cx="11" cy="11" r="8")
              path(d="m21 21-4.3-4.3")
          h3(class="text-base font-semibold text-white") No models found
          p(class="text-xs text-slate-400") Try clearing your search query or switching filters.
          button(
            @click="searchQuery = ''; selectedDifficulty = 'All'; selectedCategory = 'All'"
            class="px-4 py-2 bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 rounded-xl text-xs font-medium hover:bg-cyan-500/30 transition"
          ) Reset All Filters

        //- Models Grid
        div(
          x-show="filteredModels().length > 0"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
        )
          template(x-for="model in filteredModels()" :key="model.id")
            div(class="glass-card rounded-2xl overflow-hidden flex flex-col group")
              //- Image Container
              div(class="relative aspect-[16/11] bg-slate-950 overflow-hidden cursor-pointer" @click="openModal(model)")
                img(
                  :src="model.image"
                  :alt="model.title"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                )
                div(class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-65")
                
                //- Model ID Badge
                div(class="absolute top-2.5 left-2.5")
                  span(class="px-2.5 py-1 rounded-md bg-slate-950/85 backdrop-blur-md border border-slate-700/80 text-[11px] font-mono text-cyan-400 font-bold tracking-wider")
                    | #
                    span(x-text="model.id < 10 ? '0' + model.id : model.id")

                //- Difficulty Badge (Replaced class numbers)
                div(class="absolute top-2.5 right-2.5")
                  span(
                    class="px-2 py-0.5 rounded-md backdrop-blur-md border text-[10px] font-mono font-medium"
                    :class="getDifficultyClass(model.difficulty)"
                    x-text="model.difficulty"
                  )

                //- Build Time on bottom right of image
                div(class="absolute bottom-2 right-2.5")
                  span(class="text-[10px] font-mono px-2 py-0.5 rounded-md backdrop-blur-md bg-slate-950/80 border border-slate-800 text-slate-300 flex items-center space-x-1")
                    svg(class="w-3 h-3 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                      circle(cx="12" cy="12" r="10")
                      polyline(points="12 6 12 12 16 14")
                    span(x-text="model.buildTime")

                //- Discipline Tag on bottom left of image
                div(class="absolute bottom-2 left-2.5")
                  span(
                    class="text-[10px] font-medium px-2 py-0.5 rounded-full backdrop-blur-md bg-slate-900/90 border border-slate-700 text-slate-300"
                    x-text="model.category"
                  )

              //- Card Content
              div(class="p-4 flex-1 flex flex-col justify-between space-y-3")
                div(class="space-y-1.5")
                  h3(
                    class="font-bold text-sm sm:text-base text-white group-hover:text-cyan-300 transition-colors line-clamp-1 cursor-pointer"
                    @click="openModal(model)"
                    x-text="model.title"
                  )
                  p(class="text-xs text-slate-400 line-clamp-2 leading-relaxed" x-text="model.concept")
                  template(x-if="model.assignedStudent && model.assignedStudent.trim() !== ''")
                    div(class="flex items-center space-x-1.5 text-[11px] font-mono text-emerald-400 pt-0.5")
                      span(class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse")
                      span Student:
                      span(class="font-bold text-white truncate max-w-[150px]" x-text="model.assignedStudent")

                //- Materials preview tags
                div(class="pt-1")
                  div(class="text-[10px] font-mono text-slate-400 uppercase tracking-wide mb-1") Key Components:
                  div(class="flex flex-wrap gap-1 max-h-12 overflow-hidden")
                    template(x-for="(mat, idx) in model.materials.slice(0, 3)" :key="idx")
                      span(class="text-[10px] px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 border border-slate-700/60 truncate max-w-[130px]" x-text="mat")
                    template(x-if="model.materials.length > 3")
                      span(class="text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-400" x-text="'+' + (model.materials.length - 3)")

                //- Action Buttons
                div(class="pt-3 border-t border-slate-800/80 flex items-center gap-2")
                  button(
                    @click="openModal(model)"
                    class="flex-1 py-2 px-3 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 text-xs font-medium transition flex items-center justify-center space-x-1.5"
                  )
                    svg(class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                      path(d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z")
                      circle(cx="12" cy="12" r="3")
                    span Explore Project
                  button(
                    @click="copySpeech(model.speech, model.id)"
                    :title="copiedId === model.id ? 'Copied to clipboard!' : 'Copy Presentation Script'"
                    class="p-2 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 transition"
                  )
                    template(x-if="copiedId === model.id")
                      svg(class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                        polyline(points="20 6 9 17 4 12")
                    template(x-if="copiedId !== model.id")
                      svg(class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                        rect(width="14" height="14" x="8" y="8" rx="2" ry="2")
                        path(d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2")

      //- Rich Educational & Exhibition Section
      section#blueprint-section(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full space-y-10")
        
        //- Section 1: Presentation Formula
        div(class="glass-panel rounded-2xl p-6 sm:p-8 border border-slate-800 space-y-6")
          div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-4")
            div
              div(class="text-xs font-mono text-cyan-400 uppercase tracking-wider font-semibold") Science Exhibition Blueprint
              h2(class="text-xl sm:text-2xl font-bold text-white tracking-tight") The 4-Step Presentation Formula
            p(class="text-xs text-slate-400 max-w-md")
              | Follow this structured delivery pattern to explain any science model clearly, concisely, and with commanding confidence.
          
          div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4")
            each item in presentationFormula
              div(class="p-4 rounded-xl bg-slate-900/80 border border-slate-800 space-y-2 hover:border-cyan-500/40 transition")
                div(class="flex items-center justify-between")
                  span(class="font-mono text-xl font-extrabold text-cyan-400")= item.step
                  span(class="w-2 h-2 rounded-full bg-cyan-400/60")
                h3(class="text-sm font-bold text-white")= item.title
                p(class="text-xs text-slate-300 leading-relaxed")= item.desc

        //- Section 2: Judging Rubric & Preparation Timeline
        div(class="grid grid-cols-1 lg:grid-cols-2 gap-6")
          //- Judging Rubric
          div#rubric-section(class="glass-panel rounded-2xl p-6 border border-slate-800 space-y-5")
            div(class="flex items-center justify-between border-b border-slate-800 pb-3")
              div
                div(class="text-xs font-mono text-violet-400 uppercase tracking-wider font-semibold") Evaluation Rubric
                h3(class="text-lg font-bold text-white") How Science Models Are Judged
              span(class="text-xs font-mono px-2 py-0.5 rounded bg-violet-500/10 border border-violet-500/30 text-violet-300") 100 Points Total
            
            div(class="space-y-3")
              each rub in evaluationCriteria
                div(class="p-3 rounded-xl bg-slate-900/60 border border-slate-800/80 flex items-start justify-between gap-3")
                  div(class="space-y-1")
                    h4(class="text-xs font-bold text-white")= rub.criteria
                    p(class="text-xs text-slate-400 leading-relaxed")= rub.desc
                  span(class="font-mono text-xs font-bold px-2 py-1 rounded bg-slate-800 text-cyan-400 border border-slate-700 flex-shrink-0")= rub.weight

          //- Project Checklist Timeline
          div(class="glass-panel rounded-2xl p-6 border border-slate-800 space-y-5")
            div(class="flex items-center justify-between border-b border-slate-800 pb-3")
              div
                div(class="text-xs font-mono text-emerald-400 uppercase tracking-wider font-semibold") Project Execution Guide
                h3(class="text-lg font-bold text-white") 5 Phases From Idea to Exhibition
              span(class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-300") Best Practices
            
            div(class="space-y-2.5")
              each chk, idx in projectChecklist
                div(class="flex items-start space-x-3 p-2.5 rounded-xl bg-slate-900/60 border border-slate-800/80")
                  span(class="w-5 h-5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-mono text-[11px] font-bold flex items-center justify-center flex-shrink-0 mt-0.5")= idx + 1
                  div(class="space-y-0.5")
                    div(class="text-xs font-semibold text-slate-200")= chk.phase
                    p(class="text-xs text-slate-400 leading-relaxed")= chk.task

      //- Highly Informative & Modern Footer
      footer(class="border-t border-slate-800 bg-slate-950/90 pt-12 pb-8 px-4 sm:px-6 lg:px-8 mt-12")
        div(class="max-w-7xl mx-auto space-y-10")
          
          div(class="grid grid-cols-1 md:grid-cols-4 gap-8")
            //- Column 1: Brand & Philosophy
            div(class="space-y-3 md:col-span-1")
              div(class="flex items-center space-x-2.5")
                div(class="w-7 h-7 rounded-lg bg-gradient-to-tr from-cyan-500 to-violet-500 p-[1px] flex items-center justify-center")
                  div(class="w-full h-full bg-slate-950 rounded-[7px] flex items-center justify-center")
