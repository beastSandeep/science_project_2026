doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Science Fair Lab – Practical Working Models
    link(rel="icon" type="image/svg+xml" href="/favicon.svg")
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet")
    script(src="https://cdn.tailwindcss.com")
    script.
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
              mono: ['JetBrains Mono', 'monospace'],
            },
            colors: {
              scicyan: {
                400: '#22d3ee',
                500: '#06b6d4',
                600: '#0891b2',
              },
              sciviolet: {
                400: '#a78bfa',
                500: '#8b5cf6',
                600: '#7c3aed',
              }
            },
            animation: {
              'pulse-slow': 'pulse 7s cubic-bezier(0.4, 0, 0.6, 1) infinite',
              'spin-slow': 'spin 25s linear infinite',
            }
          }
        }
      }
    script(defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js")
    style.
      [x-cloak] { display: none !important; }
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: #020617; }
      ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }
      ::-webkit-scrollbar-thumb:hover { background: #334155; }
      .no-scrollbar::-webkit-scrollbar { display: none; }
      .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
      .glass-panel {
        background: rgba(15, 23, 42, 0.75);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(51, 65, 85, 0.55);
      }
      .glass-card {
        background: rgba(15, 23, 42, 0.68);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(51, 65, 85, 0.45);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .glass-card:hover {
        border-color: rgba(6, 182, 212, 0.55);
        box-shadow: 0 0 32px -4px rgba(6, 182, 212, 0.2);
        transform: translateY(-4px);
      }
      .text-glow-cyan {
        text-shadow: 0 0 24px rgba(6, 182, 212, 0.45);
      }
      .sci-grid {
        background-size: 38px 38px;
        background-image: 
          linear-gradient(to right, rgba(51, 65, 85, 0.08) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(51, 65, 85, 0.08) 1px, transparent 1px);
      }
      .scroll-reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
      }
      .scroll-reveal.is-revealed {
        opacity: 1;
        transform: translateY(0);
      }

  body(class="bg-slate-950 text-slate-100 min-h-screen relative font-sans overflow-x-hidden selection:bg-cyan-500 selection:text-black sci-grid" x-data="scienceFairApp()" @keydown.window="handleKeyboard($event)" x-cloak)

    //- Dynamic Scientific Canvas Background
    canvas#scientificCanvas(class="fixed inset-0 pointer-events-none z-0 opacity-70")

    //- Ambient Luminous Orbs
    div(class="fixed top-[-10%] left-[-5%] w-[48vw] h-[48vw] bg-cyan-500/10 rounded-full blur-[130px] pointer-events-none animate-pulse-slow z-0")
    div(class="fixed bottom-[-10%] right-[-5%] w-[52vw] h-[52vw] bg-violet-600/10 rounded-full blur-[150px] pointer-events-none animate-pulse-slow z-0")

    //- Main Layout Wrapper
    div(class="relative z-10 flex flex-col min-h-screen")

      //- Minimalist Glass Navbar with Responsive Mobile Hamburger Menu
      header(class="sticky top-0 z-40 glass-panel border-b border-slate-800/80" @click.outside="mobileMenuOpen = false")
        div(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between")
          //- Brand & Logo
          div(class="flex items-center space-x-2.5 sm:space-x-3 cursor-pointer min-w-0" @click="scrollToSection('hero-section'); mobileMenuOpen = false")
            div(class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-cyan-500 via-teal-400 to-violet-500 p-[1.5px] flex items-center justify-center shadow-lg shadow-cyan-500/25 flex-shrink-0")
              div(class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center")
                svg(class="w-5 h-5 text-cyan-400 animate-spin-slow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                  circle(cx="12" cy="12" r="3")
                  path(d="M12 2v2")
                  path(d="M12 20v2")
                  path(d="m4.93 4.93 1.41 1.41")
                  path(d="m17.66 17.66 1.41 1.41")
                  path(d="M2 12h2")
                  path(d="M20 12h2")
                  path(d="m6.34 17.66-1.41 1.41")
                  path(d="m19.07 4.93-1.41 1.41")
            div(class="min-w-0")
              div(class="flex items-center space-x-2")
                span(class="font-extrabold tracking-tight text-white text-sm sm:text-base truncate") SCIENCE FAIR LAB
                span(class="hidden sm:inline-block text-[10px] font-mono uppercase px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-semibold flex-shrink-0") For Everyone
              p(class="text-[10px] sm:text-[11px] text-slate-400 font-mono tracking-wide flex items-center space-x-1.5 truncate")
                span(class="text-cyan-400 font-semibold" x-text="models.length")
                span Working Models &bull; STEM Fair

          //- Desktop Navigation Links
          nav(class="hidden md:flex items-center space-x-2 lg:space-x-3")
            a(
              href="https://github.com/beastSandeep"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-1 px-2.5 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-xs text-slate-300 hover:text-white hover:border-cyan-500/40 transition"
            )
              span(class="text-slate-400") Owner:
              span(class="text-cyan-400 font-semibold") Sandeep Singh
            button(
              @click="scrollToSection('models-section')"
              class="px-3 py-1.5 rounded-lg text-xs font-medium text-cyan-400 bg-cyan-500/10 border border-cyan-500/30 hover:bg-cyan-500/20 transition-all flex items-center space-x-1.5"
            )
              span(x-text="'Models (' + models.length + ')'")
            button(
              @click="scrollToSection('blueprint-section')"
              class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800 border border-transparent hover:border-slate-700 transition-all"
            )
              span Presentation Formula
            button(
              @click="scrollToSection('rubric-section')"
              class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800 border border-transparent hover:border-slate-700 transition-all"
            )
              span Judging Rubric
            template(x-if="isVotingOpen")
              a(
                href="/rate"
                class="px-2.5 py-1.5 rounded-lg text-xs font-semibold text-purple-300 bg-purple-500/10 border border-purple-500/30 hover:bg-purple-500/20 transition-all flex items-center space-x-1"
                title="Vote &amp; Rate Projects on Mobile"
              )
                span 🗳️
                span Vote
            a(
              href="/admin"
              class="px-2.5 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-cyan-400 bg-slate-900 border border-slate-800 hover:border-cyan-500/40 transition-all flex items-center space-x-1"
              title="Admin & Coordinator Console"
            )
              svg(class="w-3.5 h-3.5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                rect(width="18" height="11" x="3" y="11" rx="2" ry="2")
                path(d="M7 11V7a5 5 0 0 1 10 0v4")
              span Admin

          //- Mobile Hamburger Button
          div(class="flex md:hidden items-center space-x-2")
            template(x-if="isVotingOpen")
              a(
                href="/rate"
                class="px-2.5 py-1.5 rounded-lg text-xs font-semibold text-purple-300 bg-purple-500/15 border border-purple-500/35 flex items-center space-x-1"
              )
                span 🗳️
                span Vote
            button(
              type="button"
              @click="mobileMenuOpen = !mobileMenuOpen"
              :aria-expanded="mobileMenuOpen.toString()"
              aria-label="Toggle navigation menu"
              class="p-2 rounded-xl bg-slate-900/90 border border-slate-700/80 text-slate-200 hover:text-cyan-400 hover:border-cyan-500/40 transition"
            )
              svg(x-show="!mobileMenuOpen" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round")
                line(x1="4" y1="6" x2="20" y2="6")
                line(x1="4" y1="12" x2="20" y2="12")
                line(x1="4" y1="18" x2="20" y2="18")
              svg(x-show="mobileMenuOpen" class="w-5 h-5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round")
                path(d="M18 6 6 18")
                path(d="m6 6 12 12")

        //- Mobile Slide-Down Drawer Menu
        div(
          x-show="mobileMenuOpen"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 -translate-y-2"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-150"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 -translate-y-2"
          class="md:hidden border-t border-slate-800/90 bg-slate-950/95 backdrop-blur-xl px-4 py-3 space-y-2 shadow-2xl"
        )
          button(
            @click="scrollToSection('models-section'); mobileMenuOpen = false"
            class="w-full px-3.5 py-2.5 rounded-xl text-left text-xs font-semibold text-cyan-300 bg-cyan-500/10 border border-cyan-500/25 flex items-center justify-between"
          )
            span 🔬 Explore Working Models
            span(class="font-mono px-2 py-0.5 rounded bg-slate-900 text-cyan-400 text-[11px]" x-text="models.length")

          button(
            @click="scrollToSection('blueprint-section'); mobileMenuOpen = false"
            class="w-full px-3.5 py-2.5 rounded-xl text-left text-xs font-medium text-slate-200 hover:bg-slate-900 border border-slate-800/80 flex items-center space-x-2.5 transition"
          )
            span 📋
            span 4-Step Presentation Formula

          button(
            @click="scrollToSection('rubric-section'); mobileMenuOpen = false"
            class="w-full px-3.5 py-2.5 rounded-xl text-left text-xs font-medium text-slate-200 hover:bg-slate-900 border border-slate-800/80 flex items-center space-x-2.5 transition"
          )
            span ⚖️
            span Judging Rubric &amp; Checklist

          template(x-if="isVotingOpen")
            a(
              href="/rate"
              @click="mobileMenuOpen = false"
              class="w-full px-3.5 py-2.5 rounded-xl text-left text-xs font-bold text-purple-200 bg-purple-500/15 border border-purple-500/35 flex items-center justify-between transition"
            )
              span(class="flex items-center space-x-2")
                span 🗳️
                span Vote &amp; Rate Projects
              span(class="text-[10px] font-mono px-2 py-0.5 rounded bg-purple-900/60 text-purple-300") LIVE

          div(class="pt-2 border-t border-slate-800/80 flex items-center justify-between gap-2")
            a(
              href="/admin"
              @click="mobileMenuOpen = false"
              class="flex-1 px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-200 bg-slate-900 border border-slate-800 hover:border-cyan-500/40 flex items-center justify-center space-x-1.5 transition"
            )
              svg(class="w-3.5 h-3.5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                rect(width="18" height="11" x="3" y="11" rx="2" ry="2")
                path(d="M7 11V7a5 5 0 0 1 10 0v4")
              span Admin Portal

            a(
              href="https://github.com/beastSandeep"
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 px-3.5 py-2.5 rounded-xl text-xs font-medium text-slate-300 bg-slate-900 border border-slate-800 flex items-center justify-center space-x-1 truncate"
            )
              span(class="text-slate-400") By:
              span(class="text-cyan-400 font-semibold truncate") Sandeep Singh

      //- Hero Section
      section#hero-section(class="pt-10 pb-6 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full")
        div(class="text-center max-w-3xl mx-auto space-y-4")
          div(class="flex flex-wrap items-center justify-center gap-2")
            div(class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-slate-900/90 border border-slate-700/80 text-xs font-mono text-cyan-300 shadow-inner")
              span(class="w-2 h-2 rounded-full bg-cyan-400 animate-ping")
              span Complete Working Mechanisms &bull; Open to All Curious Minds
            a(
              href="https://github.com/beastSandeep"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full bg-slate-900/90 border border-slate-800 hover:border-cyan-500/40 text-xs font-mono text-slate-400 transition"
            )
              span Owned by
              span(class="text-cyan-400 font-semibold") Sandeep Singh
          h1(class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight")
            span(x-text="models.length")
            |  Practical 
            span(class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-violet-400 text-glow-cyan") Science Models
          p(class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto")
            | Explore authentic hands-on models with scientific working principles, required materials, real-world industry applications, and ready-to-recite presentation speeches.

        //- Filter & Search Control Panel
        div(class="mt-8 glass-panel rounded-2xl p-4 sm:p-5 shadow-2xl border border-slate-800/90 space-y-4")
          div(class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center")
            //- Search Input
            div(class="relative flex-1")
              div(class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400")
                svg(class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                  circle(cx="11" cy="11" r="8")
                  path(d="m21 21-4.3-4.3")
              input(
                id="searchInput"
                type="text"
                x-model="searchQuery"
                placeholder="Search models, concepts (e.g. Pascal, Induction, Optics, Motor) or materials..."
                class="w-full pl-10 pr-16 py-2.5 bg-slate-900/90 border border-slate-700/80 rounded-xl text-sm text-slate-100 placeholder-slate-400 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition"
              )
              div(class="absolute inset-y-0 right-0 pr-3 flex items-center space-x-1.5")
                button(
                  x-show="searchQuery"
                  @click="searchQuery = ''"
                  class="text-slate-400 hover:text-white"
                )
                  svg(class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                    path(d="M18 6 6 18")
                    path(d="m6 6 12 12")
                span(class="hidden md:inline-block text-[10px] font-mono text-slate-400 px-1.5 py-0.5 rounded bg-slate-800 border border-slate-700") /

            //- Difficulty Filters (Replacing grade classes, suitable for everyone)
            div(class="flex items-center gap-1.5 p-1 bg-slate-900/90 border border-slate-800 rounded-xl overflow-x-auto no-scrollbar")
              button(
                @click="selectedDifficulty = 'All'"
                :class="selectedDifficulty === 'All' ? 'bg-cyan-500 text-slate-950 font-semibold shadow-sm' : 'text-slate-400 hover:text-white'"
                class="px-3 py-1.5 rounded-lg text-xs transition whitespace-nowrap"
              ) All Levels
              button(
                @click="selectedDifficulty = 'Beginner'"
                :class="selectedDifficulty === 'Beginner' ? 'bg-emerald-500 text-slate-950 font-semibold shadow-sm' : 'text-slate-400 hover:text-white'"
                class="px-3 py-1.5 rounded-lg text-xs transition whitespace-nowrap"
              ) Beginner
              button(
                @click="selectedDifficulty = 'Intermediate'"
                :class="selectedDifficulty === 'Intermediate' ? 'bg-cyan-500 text-slate-950 font-semibold shadow-sm' : 'text-slate-400 hover:text-white'"
                class="px-3 py-1.5 rounded-lg text-xs transition whitespace-nowrap"
              ) Intermediate
              button(
                @click="selectedDifficulty = 'Advanced'"
                :class="selectedDifficulty === 'Advanced' ? 'bg-violet-500 text-slate-950 font-semibold shadow-sm' : 'text-slate-400 hover:text-white'"
                class="px-3 py-1.5 rounded-lg text-xs transition whitespace-nowrap"
              ) Advanced

          //- Category Pills
          div(class="flex items-center justify-between flex-wrap gap-2 pt-2 border-t border-slate-800/80")
            div(class="flex items-center flex-wrap gap-1.5")
              span(class="text-[11px] font-mono text-slate-400 uppercase tracking-wider mr-1") Discipline:
              template(x-for="cat in categories" :key="cat")
                button(
                  @click="selectedCategory = cat"
                  :class="selectedCategory === cat ? 'bg-violet-600 text-white font-medium shadow-md shadow-violet-500/20' : 'bg-slate-900/60 text-slate-400 hover:text-slate-200 border border-slate-800'"
                  class="px-2.5 py-1 rounded-lg text-xs transition"
                  x-text="cat"
                )
            div(class="text-xs font-mono text-slate-400")
              | Showing 
              span(class="text-cyan-400 font-semibold" x-text="filteredModels().length")
              |  of 
              span(class="text-slate-300 font-semibold" x-text="models.length")
              |  models

      //- Main Content: 20 Models Grid
      main#models-section(class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 w-full flex-1")

        //- Winners Podium Showcase (Visible when any project is awarded)
        template(x-if="models.some(m => m.isWinner)")
          div(class="mb-8 p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-amber-950/40 via-yellow-950/20 to-slate-900/90 border border-amber-500/40 shadow-2xl space-y-3.5")
            div(class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-amber-500/20 pb-3")
              div(class="flex items-center space-x-3")
                div(class="w-9 h-9 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-xl shadow-inner")
                  span 🏆
                div
                  h2(class="text-base sm:text-lg font-bold text-amber-200 tracking-tight") Science Fair 2026 Champions &amp; Award Winners
                  p(class="text-xs text-slate-400") Celebrating outstanding student scientific inquiry, engineering, and working models
              button(
                @click="selectedCategory = '🏆 Winners'"
                class="px-3.5 py-1.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 text-xs font-semibold transition flex items-center space-x-1.5 self-start sm:self-auto"
              )
                span View Winners Only
                svg(class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                  path(d="m9 18 6-6-6-6")

            //- Horizontal Scroll of Winners
            div(class="flex items-center gap-3 overflow-x-auto pb-2 no-scrollbar")
              template(x-for="w in models.filter(m => m.isWinner)" :key="w.id")
                div(
                  @click="openModal(w)"
                  class="flex-shrink-0 flex items-center space-x-3 p-2.5 rounded-xl bg-slate-900/90 border border-amber-500/30 hover:border-amber-400 cursor-pointer transition min-w-[250px] max-w-[290px] group/winner"
                )
                  div(class="relative w-12 h-12 rounded-lg overflow-hidden flex-shrink-0 border border-amber-500/40")
                    img(:src="w.image" class="w-full h-full object-cover group-hover/winner:scale-110 transition-transform duration-300")
                  div(class="min-w-0 flex-1")
                    div(class="text-[10px] font-mono font-bold text-amber-400 truncate flex items-center space-x-1")
                      span(x-text="getAwardEmoji(w.award)")
                      span(x-text="w.award")
                    div(class="text-xs font-bold text-white truncate group-hover/winner:text-cyan-300 transition-colors" x-text="w.title")
                    div(class="text-[11px] text-slate-400 truncate" x-text="w.assignedStudents && w.assignedStudents.length > 0 ? w.assignedStudents.join(', ') : (w.assignedStudent || 'Student')")

        //- Empty State
        div(
          x-show="filteredModels().length === 0"
          class="glass-panel rounded-2xl p-12 text-center max-w-md mx-auto my-12 space-y-3"
        )
          div(class="w-12 h-12 mx-auto rounded-full bg-slate-800 flex items-center justify-center text-slate-400")
            svg(class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
              circle(cx="11" cy="11" r="8")
              path(d="m21 21-4.3-4.3")
          h3(class="text-base font-semibold text-white") No models found
          p(class="text-xs text-slate-400") Try clearing your search query or switching filters.
          button(
            @click="searchQuery = ''; selectedDifficulty = 'All'; selectedCategory = 'All'"
            class="px-4 py-2 bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 rounded-xl text-xs font-medium hover:bg-cyan-500/30 transition"
          ) Reset All Filters

        //- Models Grid
        div(
          x-show="filteredModels().length > 0"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
        )
          template(x-for="model in filteredModels()" :key="model.id")
            div(
              class="glass-card rounded-2xl overflow-hidden flex flex-col group relative scroll-reveal"
              :class="model.isWinner ? 'border-amber-500/70 shadow-[0_0_28px_rgba(245,158,11,0.22)] ring-1 ring-amber-500/50' : ''"
            )
              //- Image Container
              div(class="relative aspect-[16/11] bg-slate-950 overflow-hidden cursor-pointer" @click="openModal(model)")
                img(
                  :src="model.image"
                  :alt="model.title"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                )
                div(class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-65")
                
                //- Model ID Badge
                div(class="absolute top-2.5 left-2.5 z-10")
                  span(class="px-2.5 py-1 rounded-md bg-slate-950/85 backdrop-blur-md border border-slate-700/80 text-[11px] font-mono text-cyan-400 font-bold tracking-wider")
                    | #
