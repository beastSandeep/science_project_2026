                    template(x-if="model.materials.length > 3")
                      span(class="text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-400" x-text="'+' + (model.materials.length - 3)")

                //- Action Buttons
                div(class="pt-3 border-t border-slate-800/80 flex items-center gap-2")
                  button(
                    @click="openModal(model)"
                    class="flex-1 py-2 px-3 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 text-xs font-medium transition flex items-center justify-center space-x-1.5"
                  )
                    svg(class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2")
                      path(d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z")
                      circle(cx="12" cy="12" r="3")
                    span Explore Project

                  template(x-if="isVotingOpen")
                    a(
                      :href="'/rate?projectNo=' + model.id"
                      title="Vote &amp; Rate this project from mobile"
                      class="p-2 rounded-xl bg-purple-500/15 hover:bg-purple-500/30 text-purple-300 hover:text-purple-200 border border-purple-500/30 transition flex items-center justify-center flex-shrink-0"
                    )
                      span 🗳️

                  template(x-if="model.videoUrl && model.videoUrl.trim() !== ''")
                    a(
                      :href="model.videoUrl"
                      target="_blank"
                      rel="noopener noreferrer"
